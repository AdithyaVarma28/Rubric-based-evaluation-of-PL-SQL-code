create or replace function emp_fn(dept_no int) returns varchar as
$$
Declare 
g_sal numeric;b_sal numeric;com numeric;t_amt numeric;adv_sal numeric;
sal_cal cursor for select dno,basic_sal,commission,tax_amt,sal_adv from Emp_sal where dno=dept_no group by dno,basic_sal,commission,tax_amt,sal_adv;
emp_fn Emp_sal.dno%TYPE;

Begin 
open sal_cal;
Fetch sal_cal into emp_fn;
while found 

LOOP

g_sal=b_sal+com-t_amt-adv_sal;
update Emp_sal set gross_sal=g_sal where dno=dept_no;

fetch next from sal_cal into emp_fn;

End loop;
return 'Gross Salary calculated and updated';
close sal_cal;
End;
$$
language 'plpgsql';

select emp_fn(01);