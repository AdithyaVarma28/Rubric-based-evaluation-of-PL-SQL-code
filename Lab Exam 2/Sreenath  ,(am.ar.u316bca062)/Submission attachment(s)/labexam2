create or replace function gross_salary(dept_no numeric) returns numeric as
$$
	Declare
	
		gross_sala numeric;
		basic_sala numeric;
		commission_amt numeric;
		tax_amount numeric;
		sal_advance numeric;
	Begin
	
		select dno from emp_sal into dept_no;
		select basic_sal from emp_sal into basic_sala;
		select commission from emp_sal into commission_amt;
		select tax_amt from emp_sal into tax_amount;
		select sal_adv from emp_sal into sal_advance; 
		gross_sala=basic_sala+commission_amt-tax_amount-sal_adv;
		
	End;
	
$$
language 'plpgsql';
