create or replace function print(rel_year int)
	returns  varchar as
$$
  declare
	year int;
  begin
     IF year=rel_year then 
       loop
        year:=rel_year;
       select * from film;
         else 
        return 'not found';
        end loop;
         end IF;
         return 'found';
     end;
$$

  language 'plpgsql';
  
select  print(2016);
