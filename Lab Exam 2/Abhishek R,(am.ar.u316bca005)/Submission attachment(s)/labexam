create or replace function accept(y int)
returns varchar as
$$
declare
	cur_n cursor for select fname from film;
	y film.rel_year%type;
	f_name film.fname%type;
begin
	open cur_n;
	loop
	fetch cur_n into y;
	select fname into f_name from film 
	where film.rel_year=y;
	return f_name;
	end loop;
	close cur_n;
end;
$$
language 'plpgsql';




select accept(2010);