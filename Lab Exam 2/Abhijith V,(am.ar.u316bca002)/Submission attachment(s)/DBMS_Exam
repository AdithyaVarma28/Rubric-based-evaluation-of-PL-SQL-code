create or replace function year(year int)
returns varchar AS
$$
Declare
	a int Film.rel_year%type;
Begin
	IF a:=2016 THEN
	{
		select * from Film where rel_year=2016;
	}
	IF a:=2015 THEN
	{
		select * from Film where rel_year=2015;
	}
	IF a:=2014 THEN
	{
		select * from Film where rel_year=2014;
	}
	IF a:=2013 THEN
	{
		select * from Film where rel_year=2013;
	}
END;
$$
language 'plpgsql';
	