create or replace function incresalary(deptno int,n int) returns varchar as
$$
declare 
	
	empsal EmpDept.sal%type;
	p int;
begin
	p=(empsal*n)/100;
	update EmpDept set sal=sal+p where dno=deptno;
	return 'Updated';
end;
$$
language 'plpgsql'

select * from EmpDept;
select incresalary(999,10) from EmpDept;
