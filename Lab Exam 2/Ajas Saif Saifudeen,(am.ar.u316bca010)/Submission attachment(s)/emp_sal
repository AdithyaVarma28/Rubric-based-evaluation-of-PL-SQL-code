create or replace function gross_sal() 
returns varchar AS 
$$
declare
gross_sal emp_sal.gros_sal%type;
gross_sal cursor for select * from emp_sal;
Begin
open gross_sal;
Fetch gross_sal into emp_sal;
while found
Loop
Gross_sal=basic_sal+commission-tax_amt-sal_adv;
update emp_sal set gross_sal=gross_sal where eno=emp_sal.dno;
fetch next from gross_sal into emp_sal;
End loop;
close gross_sal;
return 'updated';
End;
$$
language 'plpgsql';

select gross_sal();




