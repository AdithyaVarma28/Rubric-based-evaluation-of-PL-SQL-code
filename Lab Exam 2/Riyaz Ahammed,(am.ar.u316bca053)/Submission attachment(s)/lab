create or replace function increment_salary(dn int, n int)returns varchar as
$$
	Declare 
		dn Emp_dep.dno% type;
		avg number;
		salary Emp_dep.sal% type;
	Begin
		select avg(sal) into avg from Emp_dep;
		for i in 1..4
		loop
			salary:=Emp_dep.sal*(avg/100);
		end loop;
		update Emp_dept set sal=sal+salary where dn=dno;
		return 'Table Updated';
	END
$$
	language 'plpgsql'
select increament_salary('D1',25);



