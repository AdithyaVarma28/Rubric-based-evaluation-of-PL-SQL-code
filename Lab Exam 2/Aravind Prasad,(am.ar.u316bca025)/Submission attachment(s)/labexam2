create or replace function fn_INCREMENT_SALARY (salary int)
returns int as

$$
Declare
  deptno varchar;
  N int;
  empno varchar;
  avg_sal int;

Begin
select dno into deptno from Emp_dept where empno=eno; 

avg_sal=sum(salary)/4;

salary=N%avg_sal;

salary=N+salary;

END;
$$
language 'plpgsql';