create or replace function emp_sal(id int)
returns integer As
$$
declare
cur_sal cursor for select eid,did,budget,salary from emp,dept;
id emp.eid%type;
new_sal int;

Begin
open cur_sal;
fetch cur_sal into id;
if(sum(new_sal)>budget)
then

	update salary set salary=salary+10/100;
End if;
close cur_sal;
end;
$$

language 'plpgsql';


select emp_sal(101);