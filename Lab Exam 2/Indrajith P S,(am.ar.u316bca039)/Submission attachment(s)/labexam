Create or replace function increment_salary(dept_no int,n int) returns int AS

$$
declare

emp cursor for Select salary from Emp_dept where dept_no=dno;
dept_no Emp_dept.dno%type

begin


raise notice'Enter n';

open cursor emp;

Fetch emp into dept_no;
while found
LOOP

fetch next from emp into dept_no;
END LOOP;
close emp;
return total_sal;
END;
$$
language 'plpgsql';









