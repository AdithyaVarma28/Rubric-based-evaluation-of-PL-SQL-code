create or replace function Year_search(ola int)
 returns varchar as

   $$
    Declare
            year film.rel_year%TYPE;
            were varchar;

    Begin
           Raise notice 'Enter an Year Please';
           year:=ola ;

           select fname from Film into were where rel_year= year;
           return were;
    End;

    $$
       language 'plpgsql';


select Year_search(2012);



     
           








                                