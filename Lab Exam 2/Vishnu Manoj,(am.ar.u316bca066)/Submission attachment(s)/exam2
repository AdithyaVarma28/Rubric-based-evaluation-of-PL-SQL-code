create or replace function increment_salary(dept_no varchar,n int)returns varchar as
$$
declare
	sal_up cursor for select dno,sal from  emp_dept where dno=dept_no;
	sal_update emp_dept %rowtype;
	up_sala emp_dept.sal%type;
begin
	open sal_up;
	fetch sal_up into sal_update;
	while found
	loop
	up_sala:=sal_update.sal*n/100;
	update emp_dept set sal=up_sala where dno=sal_update.dno;
	--fetch next into sal_up from sal_update;
	end loop;
	return 'table updated';
end;
$$
language 'plpgsql';

 select increment_salary('d1',5);

