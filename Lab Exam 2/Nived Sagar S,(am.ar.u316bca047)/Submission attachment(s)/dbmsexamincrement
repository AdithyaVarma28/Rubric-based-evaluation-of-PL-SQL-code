create or replace function INCREMENT_SALARY(Deptno Emp_Dept.dno%type,N int)
returns varchar AS
$$
Declare
increment_salary cursor for select eno from Emp_Dept where dno=Deptno;
Empno Emp_dept.eno%type;
Salary Emp_Dept.sal%type;
EmpSalary Emp_Dept.sal%type;

Begin
select AVG(sal) into Salary from Emp_Dept group by dno having dno=Deptno;
open increment_salary;
FETCH increment_salary into Empno;
while FOUND
LOOP

select sal into EmpSalary from Emp_Dept where eno=Empno;
EmpSalary:=EmpSalary+((Salary*N)/100);
update Emp_Dept set salary=EmpSalary where eno=Empno;
FETCH NEXT FROM increment_salary into Empno;
END LOOP;

close increment_salary;
return 'DONE';
END;
$$

language 'plpgsql';
select INCREMENT_SALARY('a1',30);
